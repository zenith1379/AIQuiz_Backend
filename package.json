{
  "name": "react-quizzes-master-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "Quiz Generator Backend - MVC Architecture",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "import-schema": "node scripts/import-schema.js",
    "migrate:speaking": "node scripts/run-speaking-migration.js",
    "migrate:metadata": "node scripts/run-metadata-migration.js",
    "test:speaking": "node tests/test-speaking-practice.js",
    "seed:superadmin": "node scripts/seed-super-admin.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^4.2.0",
    "@google-cloud/speech": "^6.4.0",
    "@google-cloud/text-to-speech": "^5.2.0",
    "@google/generative-ai": "^0.11.3",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.6",
    "groq-sdk": "^0.7.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "mongoose": "^8.12.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "paypal-rest-sdk": "^1.8.1",
    "pdf-parse": "^1.1.4",
    "sequelize": "^6.37.6",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.3",
    "supertest": "^6.3.4"
  }
}
